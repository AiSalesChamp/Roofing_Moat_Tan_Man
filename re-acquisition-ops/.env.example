# RE Acquisition Ops — copy to .env (./bin/re-ops init does this)
# Privacy default: all services bind 127.0.0.1 only. Never expose to LAN/WAN
# unless you intentionally change BIND_HOST and add auth + TLS.

BIND_HOST=127.0.0.1
COMPOSE_PROJECT_NAME=re-ops

# --- Twenty CRM (host process via yarn start) ---
TWENTY_API_URL=http://127.0.0.1:3000
TWENTY_FRONT_URL=http://127.0.0.1:3001
# Set after first login: Settings → APIs & Webhooks
TWENTY_API_KEY=

# --- Generated by ./bin/re-ops init (do not commit) ---
APP_SECRET=
UUID_NAMESPACE=6ba7b810-9dad-11d1-80b4-00c04fd430c8
N8N_CONTRACT_WEBHOOK_SECRET=
N8N_CAPTURE_WEBHOOK_SECRET=
N8N_VOICE_WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
DOCUSEAL_SECRET_KEY_BASE=
MEDIA_GATEWAY_SECRET=
OPEN_WEBUI_SECRET_KEY=
OPEN_WEBUI_PASSWORD=

# --- n8n (optional API key for auto-activate workflows) ---
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=

# --- Local AI only (no cloud LLM) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Contract services ---
DOCUSEAL_URL=http://127.0.0.1:3030
DOCUSEAL_API_TOKEN=
GOTENBERG_URL=http://127.0.0.1:3002

# --- Webhooks (logic functions + PWA) ---
N8N_CONTRACT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/re-contract/generate
N8N_DEAL_STAGE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/re-contract/deal-stage-changed
N8N_VOICE_EXTRACTION_WEBHOOK_URL=http://127.0.0.1:5678/webhook/re-voice/extract
N8N_CAPTURE_MEDIA_WEBHOOK_URL=http://127.0.0.1:5678/webhook/re-capture/media
N8N_CAPTURE_BUNDLE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/re-capture/bundle

# --- Sidecars ---
MEDIA_GATEWAY_URL=http://127.0.0.1:3081
CAPTURE_PWA_URL=http://127.0.0.1:3080
OPEN_WEBUI_URL=http://127.0.0.1:3005

# From Docker containers → host Twenty / media-gateway / host Ollama
TWENTY_API_URL_FROM_DOCKER=http://host.docker.internal:3000
MEDIA_GATEWAY_URL_FROM_DOCKER=http://host.docker.internal:3081
GOTENBERG_URL_FROM_DOCKER=http://gotenberg:3000
OLLAMA_BASE_URL_FROM_DOCKER=http://host.docker.internal:11434
# Optional bundled Ollama container: docker compose --profile bundled-ollama up -d
