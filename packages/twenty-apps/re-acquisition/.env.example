# Copy to .env.local for seed scripts and app publish.
# Get an API key from Twenty UI: Settings -> APIs & Webhooks.
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=

# Contract generation webhook (n8n) — triggered when dealStage -> OFFER_OUT
N8N_CONTRACT_WEBHOOK_URL=http://localhost:5678/webhook/re-contract/generate
N8N_CONTRACT_WEBHOOK_SECRET=

# Deal stage notification webhook (n8n) — triggered on any dealStage change
# See re-acquisition/n8n-workflows/deal-stage-notification.json
N8N_DEAL_STAGE_WEBHOOK_URL=http://localhost:5678/webhook/re-contract/deal-stage-changed

# Self-hosted contract services (see ../../re-acquisition/contracts/)
DOCUSEAL_URL=http://localhost:3030
DOCUSEAL_API_TOKEN=
GOTENBERG_URL=http://localhost:3002

# Local AI stack (see ../../re-acquisition/docker-compose.ai.yml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# n8n webhooks — voice extraction + property capture
N8N_VOICE_EXTRACTION_WEBHOOK_URL=http://localhost:5678/webhook/re-voice/extract
N8N_VOICE_WEBHOOK_SECRET=
N8N_CAPTURE_MEDIA_WEBHOOK_URL=http://localhost:5678/webhook/re-capture/media
N8N_CAPTURE_BUNDLE_WEBHOOK_URL=http://localhost:5678/webhook/re-capture/bundle
N8N_CAPTURE_WEBHOOK_SECRET=

# Open WebUI deal copilot
OPEN_WEBUI_URL=http://localhost:3005
