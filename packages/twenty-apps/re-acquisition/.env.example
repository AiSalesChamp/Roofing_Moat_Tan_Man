# Copy to .env.local for seed scripts and app publish.
# Get an API key from Twenty UI: Settings -> APIs & Webhooks.
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=

# Contract generation webhook (n8n) — triggered when dealStage -> OFFER_OUT
N8N_CONTRACT_WEBHOOK_URL=http://localhost:5678/webhook/re-contract/generate
N8N_CONTRACT_WEBHOOK_SECRET=

# Self-hosted contract services (see ../../re-acquisition/contracts/)
DOCUSEAL_URL=http://localhost:3030
DOCUSEAL_API_TOKEN=
GOTENBERG_URL=http://localhost:3001
