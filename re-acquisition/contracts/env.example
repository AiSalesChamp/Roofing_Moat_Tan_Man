# DocuSeal + Gotenberg for RE contract pipeline
# Copy to .env and source before docker compose up

# DocuSeal (e-signature)
DOCUSEAL_URL=http://localhost:3030
DOCUSEAL_API_TOKEN=
DOCUSEAL_WEBHOOK_SECRET=

# DocuSeal template IDs (set after creating templates in DocuSeal UI)
DOCUSEAL_TEMPLATE_LOI=
DOCUSEAL_TEMPLATE_PSA=
DOCUSEAL_TEMPLATE_ASSIGNMENT=

# Gotenberg (HTML → PDF)
# Note: 3002, not 3000/3001 — those are used by the Twenty API and frontend dev server
GOTENBERG_URL=http://localhost:3002

# Twenty (n8n writes)
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=

# n8n contract webhook (logic function → n8n)
N8N_CONTRACT_WEBHOOK_URL=http://localhost:5678/webhook/re-contract/generate
N8N_CONTRACT_WEBHOOK_SECRET=

# Default acquirer signer (DocuSeal Buyer role)
BUYER_SIGNER_EMAIL=
BUYER_SIGNER_NAME=
