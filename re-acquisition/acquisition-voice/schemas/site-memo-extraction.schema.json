{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://re-acquisition.crm/schemas/site-memo-extraction-1.0.json",
  "title": "SiteMemoExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentMeta", "identity", "siteFindings", "extractionMeta"],
  "properties": {
    "documentMeta": {
      "type": "object",
      "properties": {
        "referenceTimestamp": { "type": ["string", "null"], "format": "date-time" },
        "transcriptComplete": { "type": "boolean" },
        "noExtractableContent": { "type": "boolean" }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "propertyAddress": { "type": ["object", "null"] },
        "apn": { "type": ["object", "null"], "description": "{value, quote}" },
        "propertyClass": { "type": ["string", "null"] }
      }
    },
    "siteFindings": {
      "type": "object",
      "properties": {
        "inspectionType": { "type": ["string", "null"] },
        "conditionRating": { "type": ["string", "null"] },
        "accessNotes": { "type": ["string", "null"] },
        "occupancyObserved": { "type": ["string", "null"] },
        "zoningNotes": { "type": ["string", "null"] },
        "environmentalRedFlags": { "type": ["array", "null"], "items": { "type": "string" } },
        "compsMentioned": { "type": ["array", "null"], "items": { "type": "object" } },
        "estimatedValue": { "type": ["object", "null"], "description": "{value, quote}" },
        "offerIntent": { "type": ["boolean", "null"] },
        "findingsSummary": { "type": ["string", "null"] }
      }
    },
    "extractionMeta": {
      "type": "object",
      "properties": {
        "externalMemoId": { "type": "string" },
        "modelVersion": { "type": ["string", "null"] }
      },
      "required": ["externalMemoId"]
    }
  }
}
