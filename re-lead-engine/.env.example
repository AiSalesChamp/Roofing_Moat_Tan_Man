# Copy to .env

# --- Engine database (docker compose up -d) ---
ENGINE_DATABASE_URL=postgres://engine:engine@127.0.0.1:5433/re_lead_engine

# --- Twenty CRM (promotion target) ---
# Leave TWENTY_API_KEY empty to run `yarn promote --dry-run` only.
# Needs a key with data-write scope. Schema changes go through the SDK app
# (packages/twenty-apps/re-acquisition), NOT through this engine.
TWENTY_API_URL=
TWENTY_API_KEY=

# Namespace for deterministic uuidv5 record ids. MUST be the same value the other
# re-acquisition integrations use, or promotion will create duplicate records
# alongside the ones capture/voice already wrote. Defaults to the RFC 4122 DNS
# namespace, which is fine for a fresh workspace but should be set explicitly.
UUID_NAMESPACE=

# --- Scraper politeness ---
# Contact address is required: it goes in the User-Agent so a county IT admin
# can reach a human instead of silently blocking the crawler.
SCRAPER_CONTACT_EMAIL=
SCRAPER_USER_AGENT_PRODUCT=re-lead-engine/0.1
SCRAPER_MIN_DELAY_MS=2500
SCRAPER_MAX_CONCURRENCY_PER_HOST=1
SCRAPER_MAX_RETRIES=4
SCRAPER_RESPECT_ROBOTS=true

# --- Promotion gate (see docs: promotion threshold) ---
PROMOTION_MIN_SCORE=60
PROMOTION_DISTRESS_LOOKBACK_DAYS=180
PROMOTION_DEFAULT_CHANNEL=mail

# --- Channel kill switches ---
# Phone and SMS stay OFF until Texas SB 140 telemarketer registration
# (SOS Form 3401 + $10k bond) is confirmed complete. Do not flip these
# from a code change; flip them from the environment after the filing clears.
CHANNEL_MAIL_ENABLED=true
CHANNEL_EMAIL_ENABLED=false
CHANNEL_PHONE_ENABLED=false
CHANNEL_SMS_ENABLED=false
CHANNEL_ADS_ENABLED=false

# --- Skip trace (stub in Phase 0) ---
SKIP_TRACE_VENDOR=stub
SKIP_TRACE_MAX_RECORDS=1000
BATCHDATA_API_KEY=

# --- Opt-out webhook receiver ---
WEBHOOK_PORT=4310
WEBHOOK_SHARED_SECRET=
